  "item": [
    {
      "name": "0. Authentication",
      "item": [
        {
          "name": "Login (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "description": "Login returns a short-lived JWT, saved automatically as token.",
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "try { const j=pm.response.json(); if(j.accessToken) pm.environment.set('token',j.accessToken); } catch(e) {}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (Member)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "description": "Login returns a short-lived JWT, saved automatically as token.",
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{memberEmail}}\",\n  \"password\": \"{{memberPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "try { const j=pm.response.json(); if(j.accessToken) pm.environment.set('token',j.accessToken); } catch(e) {}"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify token",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/auth/verify"
          },
          "event": []
        }
      ]
    },
    {
      "name": "1. Membership plans",
      "item": [
        {
          "name": "List plans",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/membership-plans?page=1&limit=20"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "try { const j=pm.response.json(); const a=Array.isArray(j.data)?j.data:(Array.isArray(j)?j:[]); if(a[0]&&a[0].planId!==undefined) pm.environment.set('planId',String(a[0].planId)); } catch(e) {}"
                ]
